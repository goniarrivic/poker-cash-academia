rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        "goniarrivic@gmail.com"
      ];
    }

    // ─── Perfiles de usuario (progreso, xp, etc.) ───────────────────────────
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ─── Reportes de fallos en situaciones ──────────────────────────────────
    match /situationReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open";
      allow read: if isSignedIn();
      // Solo el admin puede cambiar el estado (resolved/dismissed/open)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Propuestas de edición de situaciones existentes ────────────────────
    match /editProposals/{proposalId} {
      allow create: if isSignedIn()
        && request.resource.data.proposerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.votesUp == 0
        && request.resource.data.votesDown == 0;
      allow read: if isSignedIn();
      // Cambios de estado/voto agregados (cualquier usuario autenticado o admin)
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Un voto por usuario
      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // ─── Overrides aplicados a situaciones tras una propuesta aprobada (+5) ──
    match /situationOverrides/{overrideId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Manos/situaciones propuestas por la comunidad ──────────────────────
    match /communitySituations/{situationId} {
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.votesUp == 0
        && request.resource.data.votesDown == 0;
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Un voto por usuario
      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }

    // ─── Ranking mensual de Supervivencia (1 doc por usuario, mejor marca) ──
    match /survivalLeaderboard/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ─── Insignias del Top 3 mensual de Supervivencia (calculadas por clientes) ──
    match /survivalBadges/{month} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Nombres de usuario únicos (1 doc por username en minúsculas) ───────
    // El doc id es el username normalizado a minúsculas. El campo `uid` debe
    // coincidir con el propietario para crear/actualizar/borrar, lo que impide
    // que un usuario reclame o modifique el username de otro.
    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
